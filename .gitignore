# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source data (confidential business workbooks; never commit)
/data-source/

# generated and fetched data (derived from confidential workbooks and ODbL
# boundary extracts; rebuild with `npm run data:build`, never commit)
/data/
# legacy location of the boundary layer. Nothing may be written under public/
# any more (a test fails if a data file is there); this is only a backstop.
/public/geo/
