{
  "name": "territoryiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\" \"tests/unit/**/*.test.mts\"",
    "verify:assets": "node scripts/verify-public-assets.mjs",
    "verify:build": "npm run verify:assets",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "data:verify": "node scripts/verify-sources.mts",
    "data:fetch-osm": "node scripts/fetch-osm.mts",
    "data:build": "node scripts/build-data.mts"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
